<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>POLCA-Wranglr — データ分析の前処理を超高速GUIで</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      :root {
        --bg0: #05060a;
        --bg1: #080b12;
        --bg2: #0d1119;
        --bg3: #131924;
        --bg4: #1a2130;
        --border: #1e2a3b;
        --border2: #243040;
        --cyan: #00d4ff;
        --cyan2: #00aadd;
        --cyan-glow: rgba(0, 212, 255, 0.18);
        --green: #00e599;
        --green-glow: rgba(0, 229, 153, 0.15);
        --amber: #ffb800;
        --amber-glow: rgba(255, 184, 0, 0.15);
        --red: #ff4466;
        --purple: #b06dff;
        --txt0: #edf2f8;
        --txt1: #8fa3b8;
        --txt2: #445566;
        --font-mono: 'JetBrains Mono', monospace;
        --font-head: 'Syne', sans-serif;
        --font-body: 'DM Sans', sans-serif;
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        background: var(--bg0);
        color: var(--txt0);
        font-family: var(--font-body);
        font-size: 15px;
        overflow-x: hidden;
        line-height: 1.6;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      img,
      svg {
        display: block;
        max-width: 100%;
      }
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg1);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--border2);
        border-radius: 3px;
      }
      .mono {
        font-family: var(--font-mono);
      }
      .head {
        font-family: var(--font-head);
      }
      body::before {
        content: '';
        pointer-events: none;
        position: fixed;
        inset: 0;
        z-index: 999;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
        opacity: 0.4;
      }
      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
      }
      section {
        position: relative;
      }

      /* NAV */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 32px;
        height: 60px;
        background: rgba(5, 6, 10, 0.85);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border);
      }
      .nav-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-head);
        font-weight: 800;
        font-size: 16px;
      }
      .nav-logo-icon {
        width: 30px;
        height: 30px;
        background: linear-gradient(135deg, var(--cyan), #0055ff);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-family: var(--font-mono);
        font-weight: 700;
        color: #000;
        box-shadow: 0 0 16px var(--cyan-glow);
        border-radius: 6px;
        overflow: hidden;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: 28px;
        font-size: 13px;
        color: var(--txt1);
      }
      .nav-links a:hover {
        color: var(--txt0);
      }
      .nav-cta {
        padding: 7px 20px;
        border-radius: 6px;
        background: var(--cyan);
        color: #000;
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 13px;
        transition: all 0.18s;
        box-shadow: 0 0 20px var(--cyan-glow);
      }
      .nav-cta:hover {
        background: #33ddff;
        box-shadow: 0 0 32px var(--cyan-glow);
        transform: translateY(-1px);
      }
      @media (max-width: 780px) {
        .nav-links {
          display: none;
        }
      }

      /* Eyebrow / headings */
      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px;
        border-radius: 99px;
        background: rgba(0, 212, 255, 0.08);
        border: 1px solid rgba(0, 212, 255, 0.3);
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--cyan);
        letter-spacing: 0.06em;
        margin-bottom: 20px;
      }
      .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--cyan);
        box-shadow: 0 0 8px var(--cyan);
        animation: pulseDot 2s ease-in-out infinite;
      }
      @keyframes pulseDot {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0.4;
        }
      }
      h1,
      h2,
      h3 {
        font-family: var(--font-head);
        font-weight: 800;
        letter-spacing: -0.01em;
      }
      .sec-title {
        font-size: clamp(27px, 3.6vw, 42px);
        line-height: 1.18;
        margin-bottom: 16px;
      }
      .sec-sub {
        color: var(--txt1);
        font-size: 15.5px;
        max-width: 560px;
        line-height: 1.75;
      }
      .sec-head {
        margin-bottom: 54px;
      }
      .sec-head.center {
        text-align: center;
        margin-left: auto;
        margin-right: auto;
      }
      .sec-head.center .sec-sub {
        margin-left: auto;
        margin-right: auto;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 28px;
        border-radius: 8px;
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 14.5px;
        transition: all 0.2s;
      }
      .btn-primary {
        background: var(--cyan);
        color: #000;
        box-shadow: 0 0 24px var(--cyan-glow);
      }
      .btn-primary:hover {
        background: #33ddff;
        box-shadow: 0 0 40px var(--cyan-glow);
        transform: translateY(-1px);
      }
      .btn-outline {
        border: 1px solid var(--border2);
        color: var(--txt0);
      }
      .btn-outline:hover {
        border-color: var(--cyan2);
        color: var(--cyan);
        background: var(--cyan-glow);
      }

      /* HERO */
      .hero {
        padding: 148px 0 80px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .hero::after {
        content: '';
        pointer-events: none;
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(var(--border) 1px, transparent 1px),
          linear-gradient(90deg, var(--border) 1px, transparent 1px);
        background-size: 48px 48px;
        opacity: 0.3;
        mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, black 30%, transparent 80%);
      }
      .hero-glow {
        position: absolute;
        top: -10%;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 600px;
        background: radial-gradient(ellipse, rgba(0, 212, 255, 0.08) 0%, transparent 70%);
        pointer-events: none;
      }
      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 780px;
        margin: 0 auto;
      }
      .hero h1 {
        font-size: clamp(34px, 5vw, 58px);
        line-height: 1.12;
        margin-bottom: 22px;
      }
      .hero h1 .accent {
        background: linear-gradient(90deg, var(--cyan), #0088ff, var(--purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .hero-sub {
        font-size: 16.5px;
        color: var(--txt1);
        max-width: 600px;
        margin: 0 auto 36px;
        line-height: 1.8;
      }
      .hero-sub strong {
        color: var(--txt0);
      }
      .hero-btns {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 32px;
      }
      .hero-meta {
        display: flex;
        gap: 26px;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--txt1);
        flex-wrap: wrap;
      }
      .hero-meta b {
        color: var(--txt0);
        font-weight: 600;
      }

      /* SCREENSHOT SHOWCASE (terminal window chrome) */
      .showcase {
        padding: 50px 0 110px;
      }
      .term-window {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
        box-shadow:
          0 50px 100px -30px rgba(0, 0, 0, 0.7),
          0 0 0 1px rgba(0, 212, 255, 0.06);
      }
      .term-bar {
        background: var(--bg3);
        padding: 10px 16px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 1px solid var(--border);
      }
      .term-dots {
        display: flex;
        gap: 6px;
      }
      .tdot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
      }
      .tdot-r {
        background: #ff5f57;
      }
      .tdot-y {
        background: #febc2e;
      }
      .tdot-g {
        background: #28c840;
      }
      .term-title {
        flex: 1;
        text-align: center;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--txt2);
      }
      .term-window img {
        width: 100%;
        display: block;
      }
      .showcase-caption {
        display: flex;
        justify-content: center;
        gap: 36px;
        margin-top: 28px;
        flex-wrap: wrap;
      }
      .sc-step {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--txt1);
      }
      .sc-num {
        color: var(--cyan);
        font-weight: 600;
      }
      .sc-arrow {
        color: var(--txt2);
        font-size: 13px;
      }

      /* STAT STRIP */
      .stat-strip {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--bg1);
        padding: 0;
      }
      .stat-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1px;
        background: var(--border);
      }
      .stat-cell {
        background: var(--bg1);
        padding: 32px 24px;
        text-align: center;
      }
      .stat-num {
        font-family: var(--font-head);
        font-weight: 800;
        font-size: clamp(32px, 4.4vw, 46px);
        letter-spacing: -0.02em;
        background: linear-gradient(135deg, var(--cyan), #44aaff);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: block;
      }
      .stat-label {
        font-size: 11.5px;
        color: var(--txt1);
        margin-top: 6px;
        font-family: var(--font-mono);
      }
      @media (max-width: 780px) {
        .stat-row {
          grid-template-columns: 1fr 1fr;
        }
      }

      /* PROBLEM */
      .problem {
        padding: 100px 0;
      }
      .problem-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 60px;
        align-items: center;
      }
      .bar-wrap {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .bar-track {
        height: 44px;
        border-radius: 4px;
        overflow: hidden;
        display: flex;
        border: 1px solid var(--border2);
      }
      .bar-seg {
        display: flex;
        align-items: center;
        height: 100%;
        font-family: var(--font-mono);
        font-size: 11.5px;
        color: #000;
        padding-left: 13px;
        font-weight: 600;
      }
      .bar-seg.a {
        background: var(--txt2);
        color: var(--bg0);
        width: 80%;
      }
      .bar-seg.b {
        background: var(--cyan);
        width: 20%;
      }
      .bar-legend {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--txt1);
      }
      .bar-legend b {
        color: var(--txt0);
      }
      .problem-quote {
        margin-top: 26px;
        padding: 16px 20px;
        border-left: 2px solid var(--cyan);
        font-size: 15.5px;
        color: var(--txt0);
        line-height: 1.7;
        background: var(--cyan-glow);
        border-radius: 0 6px 6px 0;
      }
      @media (max-width: 780px) {
        .problem-grid {
          grid-template-columns: 1fr;
        }
      }

      /* CORE CAPABILITIES */
      .core {
        padding: 100px 0;
        background: var(--bg1);
      }
      .core-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        background: var(--border);
      }
      .core-card {
        background: var(--bg1);
        padding: 34px 28px;
        position: relative;
        overflow: hidden;
        transition: background 0.2s;
      }
      .core-card:hover {
        background: var(--bg2);
      }
      .core-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--cyan), transparent);
        opacity: 0;
        transition: opacity 0.3s;
      }
      .core-card:hover::before {
        opacity: 1;
      }
      .core-num {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--txt2);
        margin-bottom: 14px;
      }
      .core-card h3 {
        font-size: 19px;
        margin-bottom: 10px;
        line-height: 1.3;
      }
      .core-card p {
        color: var(--txt1);
        font-size: 13.6px;
        line-height: 1.75;
        margin-bottom: 16px;
      }
      .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .chip {
        padding: 3px 10px;
        border-radius: 99px;
        font-family: var(--font-mono);
        font-size: 10.6px;
        background: rgba(0, 212, 255, 0.07);
        color: var(--cyan);
        border: 1px solid rgba(0, 212, 255, 0.2);
      }
      @media (max-width: 780px) {
        .core-grid {
          grid-template-columns: 1fr;
        }
      }

      /* NO-CODE STRIP */
      .nocode {
        padding: 54px 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
      }
      .nocode-row {
        display: flex;
        align-items: center;
        gap: 34px;
        justify-content: center;
        flex-wrap: wrap;
      }
      .nocode-eq {
        display: flex;
        align-items: center;
        gap: 14px;
        font-family: var(--font-mono);
        font-size: 12.5px;
        color: var(--txt1);
      }
      .code-strike {
        position: relative;
        color: var(--txt2);
      }
      .code-strike::after {
        content: '';
        position: absolute;
        left: -2px;
        right: -2px;
        top: 50%;
        height: 1.5px;
        background: var(--red);
        transform: rotate(-3deg);
      }
      .nocode-eq .arrow {
        color: var(--txt2);
      }
      .nocode-eq .result {
        color: var(--cyan);
        font-weight: 600;
      }

      /* POLARS SECTION (glow panel for contrast) */
      .polars-sec {
        padding: 100px 0;
        background: var(--bg0);
      }
      .tech-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--border);
        margin-top: 46px;
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }
      .tech-cell {
        background: var(--bg1);
        padding: 28px 26px;
      }
      .tech-cell h4 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: 15px;
        color: var(--txt0);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 9px;
      }
      .tech-num {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--cyan);
      }
      .tech-cell p {
        font-size: 13px;
        color: var(--txt1);
        line-height: 1.75;
      }
      @media (max-width: 780px) {
        .tech-grid {
          grid-template-columns: 1fr;
        }
      }
      .speed-strip {
        display: flex;
        gap: 1px;
        margin-top: 22px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }
      .speed-cell {
        flex: 1;
        background: var(--bg1);
        padding: 22px 18px;
        text-align: center;
      }
      .speed-num {
        font-family: var(--font-head);
        font-weight: 800;
        font-size: 27px;
        color: var(--cyan);
      }
      .speed-label {
        font-family: var(--font-mono);
        font-size: 10.5px;
        color: var(--txt1);
        margin-top: 6px;
      }
      @media (max-width: 780px) {
        .speed-strip {
          flex-direction: column;
        }
      }

      /* ZERO WAIT */
      .zerowait {
        padding: 100px 0;
        background: var(--bg1);
      }
      .zw-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }
      .zw-card {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 26px 22px;
        transition: border-color 0.2s;
      }
      .zw-card:hover {
        border-color: var(--cyan2);
      }
      .zw-time {
        font-family: var(--font-head);
        font-weight: 800;
        font-size: 24px;
        color: var(--green);
        margin-bottom: 8px;
      }
      .zw-title {
        font-weight: 700;
        color: var(--txt0);
        font-size: 13.6px;
        margin-bottom: 8px;
        font-family: var(--font-body);
      }
      .zw-desc {
        font-size: 12.6px;
        color: var(--txt1);
        line-height: 1.7;
      }
      @media (max-width: 780px) {
        .zw-grid {
          grid-template-columns: 1fr;
        }
      }

      /* RECIPE -> CODE */
      .recipe {
        padding: 100px 0;
      }
      .recipe-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 52px;
        align-items: center;
      }
      .rs-item {
        display: flex;
        gap: 14px;
        padding: 16px 0;
        border-bottom: 1px solid var(--border);
      }
      .rs-item:last-child {
        border-bottom: none;
      }
      .rs-num {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--cyan);
        flex-shrink: 0;
        width: 22px;
        padding-top: 3px;
      }
      .rs-title {
        font-weight: 700;
        color: var(--txt0);
        font-size: 14px;
        margin-bottom: 4px;
        font-family: var(--font-body);
      }
      .rs-desc {
        font-size: 12.6px;
        color: var(--txt1);
        line-height: 1.7;
      }
      .code-card {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 22px 24px;
        font-family: var(--font-mono);
        font-size: 12px;
        line-height: 2;
        color: var(--txt1);
        overflow-x: auto;
      }
      .code-card .c1 {
        color: var(--txt2);
      }
      .code-card .c2 {
        color: var(--green);
      }
      .code-card .c3 {
        color: var(--purple);
      }
      @media (max-width: 780px) {
        .recipe-grid {
          grid-template-columns: 1fr;
        }
      }

      /* FEATURE TABLE */
      .ftable-sec {
        padding: 100px 0;
        background: var(--bg1);
      }
      .ftable {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.4px;
      }
      .ftable th {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--cyan);
        text-align: left;
        padding: 13px 18px;
        border-bottom: 2px solid var(--border2);
        background: var(--bg2);
      }
      .ftable th:not(:first-child) {
        text-align: center;
        width: 86px;
      }
      .ftable td {
        padding: 13px 18px;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
      }
      .ftable tr:last-child td {
        border-bottom: none;
      }
      .ftable tr:hover td {
        background: var(--bg2);
      }
      .f-name {
        font-weight: 500;
        color: var(--txt0);
      }
      .f-sub {
        font-size: 11.4px;
        color: var(--txt2);
        margin-top: 2px;
        font-family: var(--font-mono);
      }
      .dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
      }
